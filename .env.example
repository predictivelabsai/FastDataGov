# Runtime
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
HOST=0.0.0.0
PORT=5062
BASE_URL=http://localhost:5062
ALLOWED_HOSTS=localhost,127.0.0.1

# `demo` is an in-memory deterministic showcase. Use `postgres` for persistent data.
REPOSITORY_MODE=demo
DB_URL=postgresql://fastdatagov:fastdatagov@localhost:5432/fastdatagov
DB_SCHEMA=fast_datagov
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Authentication: `dev` for local work; `entra` or `google` for production.
AUTH_MODE=dev
DEV_AUTH_ENABLED=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5062/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
GOVERNANCE_ADMIN_EMAILS=

# Initial single-container deployments can run one scheduler and worker beside the web process.
RUN_BACKGROUND_WORKERS=false

# Optional access restrictions. Comma-separated, empty means tenant-wide.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Platform credentials are read only by workers. Prefer secret-manager injection.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=GOVERNANCE_WH
SNOWFLAKE_ROLE=DATA_GOVERNANCE_READER
SNOWFLAKE_QUALITY_WAREHOUSE=GOVERNANCE_QUALITY_WH
SNOWFLAKE_QUALITY_ROLE=DATA_QUALITY_EXECUTOR
SNOWFLAKE_WRITEBACK_ROLE=

# Dedicated adapter and quality worker controls.
SYNC_INTERVAL_MINUTES=60
JOB_POLL_SECONDS=2
JOB_LEASE_SECONDS=900
QUALITY_STATEMENT_TIMEOUT_SECONDS=120

# Optional notification delivery. Channel endpoints are referenced as env:NAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=fastdatagov@example.com
NOTIFICATION_WEBHOOK_HOSTS=hooks.slack.com,example.webhook.office.com
GOVERNANCE_FALLBACK_ASSIGNEE=governance@example.com
